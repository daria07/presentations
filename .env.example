APP_NAME="Слайдуша"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Куда приходят отзывы из формы обратной связи
MAIL_FEEDBACK_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LLM_BASE_URL=https://cheapai.io
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Цены шлюза за 1M токенов, в сотых доли цента: 2700 = $0.27
LLM_PRICE_INPUT=2700
LLM_PRICE_OUTPUT=13300

# Картинки для слайдов. Пусто — картинок нет. Шлюз и ключ по умолчанию
# те же, что у текста. Цены в сотых доли цента за 1M токенов: $9 = 90000
IMAGE_BASE_URL=https://api.cheapai.io
IMAGE_MODEL=grok-imagine-image
# IMAGE_API: openai (по умолчанию) — /v1/images/generations, как у cheapai;
# async — очередь задач /v1/media/generations (sozdai.ai, ~4,25 ₽ за 1K):
# IMAGE_API=async
# IMAGE_BASE_URL=https://api.sozdai.ai
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2
# IMAGE_RESOLUTION=1K
# Запасной шлюз: к нему уходят картинки, которые основной не отдал
# IMAGE_FALLBACK_BASE_URL=
# IMAGE_FALLBACK_API_KEY=
# IMAGE_FALLBACK_MODEL=
IMAGE_QUALITY=medium
IMAGE_PRICE_INPUT=15000
IMAGE_PRICE_OUTPUT=90000

# Реквизиты для оферты и политики конфиденциальности
LEGAL_NAME="Куралесина Дарья Сергеевна"
LEGAL_INN=
LEGAL_EMAIL=hello@slaidusha.ru
LEGAL_SITE=slaidusha.ru
LEGAL_UPDATED_AT="5 сентября 2026 года"

# fake — заглушка для разработки, yookassa — боевой приём
BILLING_PROVIDER=fake
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Автоматические чеки. Выключено: ЮKassa закрыла выдачу чеков
# самозанятым 29.12.2025, чеки выбиваются вручную в «Мой налог»
YOOKASSA_RECEIPTS=false

# Кому открыт кабинет администратора (через запятую)
ADMIN_EMAILS=

# Кто видит служебный пакет «Тест» за 10 ₽ (почты через запятую).
# Пусто — пакет скрыт от всех, звёздочка — открыт всем, кто вошёл.
# Перед запуском рекламы звёздочку убрать
BILLING_TEST_EMAILS=

# Яндекс Метрика. Пусто — счётчик не подключается: локальные заходы
# и прогоны тестов не должны попадать в статистику.
YANDEX_METRIKA_ID=

# Поиск источников (Яндекс Search API). Пусто — без источников
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Вход через VK ID: номер приложения из кабинета id.vk.com.
# Пусто — кнопки «Войти через VK ID» нет
VKID_CLIENT_ID=

# Вход через Google: OAuth client ID и секрет из Google Cloud Console.
# Пусто — кнопки «Войти через Google» нет
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
